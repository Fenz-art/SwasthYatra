{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@agent-core/*": ["./packages/agent-core/*"],
      "@healthcare-graph/*": ["./packages/healthcare-graph/*"],
      "@/packages/*": ["./packages/*"],
      "@event-bus/*": ["./packages/event-bus/*"],
      "@provider-sync/*": ["./packages/provider-sync/*"],
      "@observability": ["./packages/observability"],
      "@observability/*": ["./packages/observability/*"],
      "@realtime": ["./packages/realtime"],
      "@realtime/*": ["./packages/realtime/*"],
      "@agent-runtime": ["./packages/agent-runtime"],
      "@agent-runtime/*": ["./packages/agent-runtime/*"],
      "@outcome-engine": ["./packages/outcome-engine"],
      "@outcome-engine/*": ["./packages/outcome-engine/*"],
      "@followup-engine": ["./packages/followup-engine"],
      "@followup-engine/*": ["./packages/followup-engine/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
